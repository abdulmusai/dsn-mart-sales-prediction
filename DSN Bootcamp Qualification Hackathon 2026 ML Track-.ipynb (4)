"executionInfo":{"status":"ok","timestamp":1789953379329,"user_tz":-60,"elapsed":117,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}}},"execution_count":41,"outputs":[]},{"cell_type":"code","source":["\n","# Target distribution\n","sns.histplot(train['total_sales'], kde=True)\n","plt.title('Total Sales Distribution')\n","plt.show()\n","\n","# Missing values\n","sns.heatmap(train.isnull(), cbar=False)\n","plt.title('Missing Values')\n","plt.show()\n","\n","# Sales by store format / size\n","sns.boxplot(data=train, x='store_format', y='total_sales')\n","plt.xticks(rotation=45)\n","plt.title('Sales by Store Format')\n","plt.show()\n","\n","sns.boxplot(data=train, x='store_size', y='total_sales')\n","plt.title('Sales by Store Size')\n","plt.show()\n","\n","# Price vs sales\n","sns.scatterplot(data=train, x='product_price', y='total_sales', alpha=0.4)\n","plt.title('Price vs Sales')\n","plt.show()\n","\n","# shelf_visibility == 0 check (this is what tells you to treat it as missing)\n","print('Rows with shelf_visibility == 0:', (train['shelf_visibility'] == 0).sum())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"B_CfnP_ue4sH","executionInfo":{"status":"ok","timestamp":1789953396005,"user_tz":-60,"elapsed":11932,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}},"outputId":"cb72f509-b7d3-43e3-9461-3dc9a6ff45f0"},"execution_count":42,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Rows with shelf_visibility == 0: 422\n"]}]},{"cell_type":"code","source":["\n","# ---------- 1. Clean product_category casing ----------\n","full['product_category'] = full['product_category'].str.strip().str.title()\n","full['product_category'] = full['product_category'].replace({\n","    'Fruits And Vegetables': 'Fruits and Vegetables',\n","    'Health And Hygiene': 'Health and Hygiene',\n","})\n","perishable = {'Dairy', 'Meat', 'Seafood', 'Fruits and Vegetables', 'Breads', 'Breakfast'}\n","full['category_group'] = np.where(full['product_category'].isin(perishable), 'Perishable', 'Non-Perishable')"],"metadata":{"id":"FWsUlpAa8rQ3","executionInfo":{"status":"ok","timestamp":1789953414684,"user_tz":-60,"elapsed":90,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}}},"execution_count":43,"outputs":[]},{"cell_type":"code","source":["\n","# ---------- 2. Impute product_weight_kg ----------\n","weight_by_code = full.groupby('product_code')['product_weight_kg'].transform('mean')\n","full['product_weight_kg'] = full['product_weight_kg'].fillna(weight_by_code)\n","cat_mean_weight = full.groupby('product_category')['product_weight_kg'].transform('mean')\n","full['product_weight_kg'] = full['product_weight_kg'].fillna(cat_mean_weight)"],"metadata":{"id":"-7f0qR5MFqp0","executionInfo":{"status":"ok","timestamp":1789953419160,"user_tz":-60,"elapsed":128,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}}},"execution_count":44,"outputs":[]},{"cell_type":"code","source":["\n","# ---------- 3. Fix shelf_visibility == 0 ----------\n","full.loc[full['shelf_visibility'] == 0, 'shelf_visibility'] = np.nan\n","vis_by_cat = full.groupby('product_category')['shelf_visibility'].transform('mean')\n","full['shelf_visibility'] = full['shelf_visibility'].fillna(vis_by_cat)"],"metadata":{"id":"TcklJJnNF_nQ","executionInfo":{"status":"ok","timestamp":1789953433717,"user_tz":-60,"elapsed":82,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}}},"execution_count":47,"outputs":[]},{"cell_type":"code","source":["\n","# ---------- 4. store_size missingness ----------\n","full['store_size'] = full['store_size'].fillna('Missing')"],"metadata":{"id":"kBtwO7yNGZv0","executionInfo":{"status":"ok","timestamp":1789953427118,"user_tz":-60,"elapsed":32,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}}},"execution_count":46,"outputs":[]},{"cell_type":"code","source":["\n","# ---------- 5. Basic feature engineering ----------\n","full['store_age_bucket'] = pd.cut(full['store_age_years'], bins=[0, 10, 20, 30, 40, 100],\n","                                   labels=['0-10', '11-20', '21-30', '31-40', '40+'])\n","full['price_per_kg'] = full['product_price'] / full['product_weight_kg']\n","full['product_count_in_store'] = full.groupby('store_code')['product_code'].transform('count')\n","full['store_count_for_product'] = full.groupby('product_code')['store_code'].transform('count')\n","\n","train_fe = full[full['is_train'] == 1].copy().reset_index(drop=True)\n","test_fe = full[full['is_train'] == 0].copy().reset_index(drop=True)\n","\n","y_log = np.log1p(train_fe['total_sales'])"],"metadata":{"id":"MITAKiEbGbAY","executionInfo":{"status":"ok","timestamp":1789953441016,"user_tz":-60,"elapsed":78,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}}},"execution_count":48,"outputs":[]},{"cell_type":"code","source":["\n","# ---------- 6. Out-of-fold smoothed target encoding (leak-free) ----------\n","def smoothed_te_oof(train_df, test_df, col, target, n_splits=5, smoothing=10, seed=42):\n","    global_mean = target.mean()\n","    oof = np.full(len(train_df), np.nan)\n","    kf_te = KFold(n_splits=n_splits, shuffle=True, random_state=seed)\n","    for tr_idx, val_idx in kf_te.split(train_df):\n","        stats = target.iloc[tr_idx].groupby(train_df[col].iloc[tr_idx]).agg(['mean', 'count'])\n","        smooth = (stats['mean'] * stats['count'] + global_mean * smoothing) / (stats['count'] + smoothing)\n","        oof[val_idx] = train_df[col].iloc[val_idx].map(smooth).fillna(global_mean).values\n","    # full-train stats for encoding test set\n","    stats_full = target.groupby(train_df[col]).agg(['mean', 'count'])\n","    smooth_full = (stats_full['mean'] * stats_full['count'] + global_mean * smoothing) / (stats_full['count'] + smoothing)\n","    test_enc = test_df[col].map(smooth_full).fillna(global_mean).values\n","    return oof, test_enc\n","\n","for col in ['product_code', 'store_code', 'product_category']:\n","    oof_enc, test_enc = smoothed_te_oof(train_fe, test_fe, col, y_log, n_splits=5, smoothing=10)\n","    train_fe[f'{col}_te'] = oof_enc\n","    test_fe[f'{col}_te'] = test_enc\n","\n","# store-level / category-level avg sales (train-only, safe since store/category identity known upfront,\n","# but to avoid subtle leakage on small stores we reuse the same OOF style for store_code above;\n","# keep a simple category_avg_sales too since categories are broad and low-risk)\n","cat_stats = train_fe.groupby('product_category')['total_sales'].transform('mean')\n","train_fe['category_avg_sales'] = cat_stats\n","cat_map = train_fe.groupby('product_category')['total_sales'].mean()\n","test_fe['category_avg_sales'] = test_fe['product_category'].map(cat_map)\n","\n","cat_cols = ['fat_content', 'product_category', 'category_group',\n","            'store_code', 'store_size', 'store_location_tier', 'store_format', 'store_age_bucket']\n","for c in cat_cols:\n","    train_fe[c] = train_fe[c].astype('category')\n","    test_fe[c] = test_fe[c].astype('category')\n","\n","feature_cols = ['product_weight_kg', 'fat_content', 'shelf_visibility', 'product_category',\n","                 'category_group', 'product_price', 'store_code', 'store_age_years', 'store_size',\n","                 'store_location_tier', 'store_format', 'store_age_bucket', 'price_per_kg',\n","                 'category_avg_sales', 'product_count_in_store', 'store_count_for_product',\n","                 'product_code_te', 'store_code_te', 'product_category_te']\n","\n","X = train_fe[feature_cols]\n","y = y_log\n","X_test = test_fe[feature_cols]\n","\n","cat_feature_names = [c for c in cat_cols if c in feature_cols]\n","cat_idx = [X.columns.get_loc(c) for c in cat_feature_names]\n","\n","kf = KFold(n_splits=N_SPLITS, shuffle=True, random_state=RANDOM_STATE)\n","\n","oof_lgb = np.zeros(len(X))\n","oof_cat = np.zeros(len(X))\n","test_pred_lgb = np.zeros(len(X_test))\n","test_pred_cat = np.zeros(len(X_test))\n","\n","lgb_params = dict(\n","    objective='regression', metric='rmse', n_estimators=3000, learning_rate=0.02,\n","    num_leaves=31, min_child_samples=20, subsample=0.8, colsample_bytree=0.8,\n","    reg_alpha=0.1, reg_lambda=0.1, random_state=RANDOM_STATE, verbosity=-1,\n",")\n","\n","for fold, (tr_idx, val_idx) in enumerate(kf.split(X)):\n","    X_tr, X_val = X.iloc[tr_idx].copy(), X.iloc[val_idx].copy()\n","    y_tr, y_val = y.iloc[tr_idx], y.iloc[val_idx]"],"metadata":{"id":"yRRB5LBtGlzB","executionInfo":{"status":"ok","timestamp":1789953446184,"user_tz":-60,"elapsed":182,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}}},"execution_count":49,"outputs":[]},{"cell_type":"code","source":["\n","# LightGBM\n","lgb_model = lgb.LGBMRegressor(**lgb_params)\n","lgb_model.fit(X_tr, y_tr, eval_set=[(X_val, y_val)],\n","callbacks=[lgb.early_stopping(100, verbose=False)])\n","oof_lgb[val_idx] = lgb_model.predict(X_val, num_iteration=lgb_model.best_iteration_)\n","test_pred_lgb += lgb_model.predict(X_test, num_iteration=lgb_model.best_iteration_) / N_SPLITS\n","\n","# CatBoost\n","cat_model = CatBoostRegressor(\n","        iterations=3000, learning_rate=0.03, depth=6, loss_function='RMSE',\n","        random_seed=RANDOM_STATE, verbose=False, early_stopping_rounds=100,\n","        cat_features=cat_idx,\n","    )\n","cat_model.fit(X_tr, y_tr, eval_set=(X_val, y_val), use_best_model=True)\n","oof_cat[val_idx] = cat_model.predict(X_val)\n","test_pred_cat += cat_model.predict(X_test) / N_SPLITS\n","\n","y_orig = train_fe['total_sales'].values\n","\n","def rmse_orig(oof_log):\n","       return np.sqrt(np.mean((np.expm1(oof_log) - y_orig) ** 2))\n","\n","print(f'LightGBM CV RMSE: {rmse_orig(oof_lgb):.4f}')\n","print(f'CatBoost CV RMSE: {rmse_orig(oof_cat):.4f}')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"OiN-Lg_qG99l","executionInfo":{"status":"ok","timestamp":1789953468321,"user_tz":-60,"elapsed":9153,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}},"outputId":"9b2d8bd3-bf47-4932-ea9b-21404a3c26d0"},"execution_count":50,"outputs":[{"output_type":"stream","name":"stdout","text":["LightGBM CV RMSE: 2513.9371\n","CatBoost CV RMSE: 2512.5878\n"]}]},{"cell_type":"code","source":["best_w, best_rmse = None, np.inf\n","for w in np.arange(0, 1.01, 0.05):\n","      blend = w * oof_lgb + (1 - w) * oof_cat\n","      r = rmse_orig(blend)\n","      if r < best_rmse:\n","          best_rmse, best_w = r, w\n","\n","print(f'Best blend weight (LGB={best_w:.2f}, Cat={1-best_w:.2f}) CV RMSE: {best_rmse:.4f}')\n","\n","final_test_log = best_w * test_pred_lgb + (1 - best_w) * test_pred_cat\n","final_test = np.clip(np.expm1(final_test_log), 0, None)\n","\n","submission = pd.DataFrame({'id': test_fe['id'].values, 'total_sales': final_test})\n","submission.to_csv('submission.csv', index=False)\n","print(submission.head())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"agrP38tBJBO0","executionInfo":{"status":"ok","timestamp":1789953476491,"user_tz":-60,"elapsed":97,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}},"outputId":"7d16111f-de1a-4a61-b4da-dbe1dc641dc9"},"execution_count":51,"outputs":[{"output_type":"stream","name":"stdout","text":["Best blend weight (LGB=0.00, Cat=1.00) CV RMSE: 2512.5878\n","          id  total_sales\n","0  row_00009     3.753679\n","1  row_00015     4.154199\n","2  row_00019     3.922975\n","3  row_00020     3.936118\n","4  row_00023     3.686987\n"]}]},{"cell_type":"code","source":["\n","# Feature importance\n","imp = pd.Series(cat_model.feature_importances_, index=feature_cols).sort_values()\n","imp.plot(kind='barh', figsize=(8,6))\n","plt.title('Feature Importance (CatBoost)')\n","plt.show()\n","\n","# Predicted vs actual (on OOF predictions)\n","plt.scatter(y_orig, np.expm1(oof_cat), alpha=0.4)\n","plt.plot([y_orig.min(), y_orig.max()], [y_orig.min(), y_orig.max()], 'r--')\n","plt.xlabel('Actual Sales')\n","plt.ylabel('Predicted Sales')\n","plt.title('Predicted vs Actual')\n","plt.show()\n","\n","# Residuals\n","residuals = y_orig - np.expm1(oof_cat)\n","sns.histplot(residuals, kde=True)\n","plt.title('Residuals Distribution')\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":877},"id":"VaSV492whyof","executionInfo":{"status":"ok","timestamp":1789953484585,"user_tz":-60,"elapsed":1996,"user":{"displayName":"Abdulrahman Musa Inuwa","userId":"16595055567431195168"}},"outputId":"927e2e94-4365-4113-bd0b-ec80773ce01d"},"execution_count":52,"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"code","source":["submission.to_csv('/submission.csv', index=False)\n","\n","from google.colab import files\n","files.download('/submission.csv')\n","\n","print('Saved improved submission.csv with', len(submission), 'rows')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":34},"id":"VLt1ad6xgAOx","executionI